# Where the enquiry form posts. Without it the form falls back to composing a
# mailto: in the visitor's mail client, which works but loses most enquiries.
#
# Simplest option — Formspree (free tier, no backend to run):
#   1. Sign up at https://formspree.io and create a form
#   2. Set its destination to whichever inbox should receive enquiries
#   3. Copy the form's endpoint URL below
#   4. Copy this file to `.env` (git-ignored) and set the value there too
#
# The destination address lives in Formspree, not here, so it never ships in
# the bundle where it would be scraped.
VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
